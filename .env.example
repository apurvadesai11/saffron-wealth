# Database
# Local dev: `brew services start postgresql@16` then `createdb saffron_dev`
DATABASE_URL="postgresql://localhost:5432/saffron_dev"

# Auth — Google OAuth (optional; required only if using the Google sign-in flow)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# Email — Resend (optional; required only for password-reset emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# Rate limiting — Upstash Redis (optional; without these, limits no-op)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Profile picture storage — Vercel Blob (optional; required only for picture upload)
BLOB_READ_WRITE_TOKEN=""

# Cron auth — used by /api/cron/* endpoints (any opaque string)
CRON_SECRET=""
